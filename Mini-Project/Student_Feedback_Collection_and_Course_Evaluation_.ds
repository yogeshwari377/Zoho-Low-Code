 application "Student Feedback Collection and Course Evaluation "
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "America/Los_Angeles"
 	time format = "24-hr"

 	forms
	{
		form course
		{
			displayname = "Course"
			success message = "Course Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			course_code
			(
    			type = text
				displayname = "Course Code"
	 			row = 1
	 			column = 1   
				width = medium
			)
			course_name
			(
    			type = text
				displayname = "Course Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			instructor_name
			(
    			type = name
				displayname = "Instructor Name"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
	     			 visibility = false
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
			department
			(
    			type = text
				displayname = "Department"
	 			row = 1
	 			column = 1   
				width = medium
			)
			semester
			(
    			type = text
				displayname = "Semester"
	 			row = 1
	 			column = 1   
				width = medium
			)
			academic_year
			(
    			type = text
				displayname = "Academic Year"
	 			row = 1
	 			column = 1   
				width = medium
			)
			credits
			(
				type = number
				displayname = "Credits"
				maxchar = 19
	 			row = 1
	 			column = 1   
				width = medium
			)
			course_type
			(
				type = picklist
				displayname = "Course Type"
				values = {"Theory","Lab","Lab+Theory"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			instructor_email
			(
    			type = email
				displayname = "Instructor Email"
				maxchar = 80
	 			row = 1
	 			column = 1   
				width = medium
			)
			Course_Feedback_Criteria
			(
				type = grid
				displayname = "Course Feedback Criteria"
				criteria_name
				(
					type = picklist
					displayname = "Evaluation Criteria"
					maxchar = 100
					values = {"Content Quality","Delivery","Clarity","Engagement"}
					width = medium
				)
				maximum_rating
				(
					type = number
					displayname = "Maximum Rating"
					initial value = 5
					width = medium
				)
				description
				(
    				type = text
					displayname = "Description"
					width = medium
				)
	 			row = 2
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form feedback_response
		{
			displayname = "Feedback Response"
			success message = "Response Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have unique response_id
			(
    			type = text
				displayname = "Response Id"
	 			row = 1
	 			column = 1   
				width = medium
			)
			student
			(
				type = list	
				displayname = "Student"
				values  = student.ID
    			displayformat = [student_id]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			course
			(
				type = list	
				displayname = "Course"
				values  = course.ID
    			displayformat = [course_code]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			submission_date
			(
    			type = datetime
				displayname = "Submission Date"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			content_quality_rating
			(
				type = number
				displayname = "Content Quality Rating"
				maxchar = 19
	 			row = 1
	 			column = 1   
				width = medium
			)
			delivery_rating
			(
				type = number
				displayname = "Delivery Rating"
				maxchar = 19
	 			row = 1
	 			column = 1   
				width = medium
			)
			clarity_rating
			(
				type = number
				displayname = "Clarity Rating"
				maxchar = 19
	 			row = 1
	 			column = 1   
				width = medium
			)
			engagement_rating
			(
				type = number
				displayname = "Engagement Rating"
				maxchar = 19
	 			row = 1
	 			column = 1   
				width = medium
			)
			overall_satisfaction
			(
				type = picklist
				displayname = "Overall Satisfaction"
				values = {"Neutral","Very Satisfied","Satisfied","Very Dissatisfied","Dissatisfied"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			suggestions
			(
    			type = textarea
				displayname = "Suggestions"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			is_anonymous
			(
    			type = checkbox
				displayname = "Is Anonymous"
				initial value = false
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
			blueprint components
			{
				stages = {"Feedback Received","Feedback Under Review","Feedback Archived","Feedback Approved","Feedback Rejected","Feedback Pending Clarification","Feedback Analyzed","Feedback Actioned"}
			}
		}
		form semester_summary
		{
			displayname = "Semester Summary"
			success message = "Semester Summary Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have unique summary_id
			(
    			type = text
				displayname = "Summary Id"
	 			row = 1
	 			column = 1   
				width = medium
			)
			course
			(
				type = list	
				displayname = "Course"
				values  = course.ID
    			displayformat = [course_code]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			semester
			(
    			type = text
				displayname = "Semester"
	 			row = 1
	 			column = 1   
				width = medium
			)
			academic_year
			(
    			type = text
				displayname = "Academic Year"
	 			row = 1
	 			column = 1   
				width = medium
			)
			total_responses
			(
				type = number
				displayname = "Total Responses"
				maxchar = 19
	 			row = 1
	 			column = 1   
				width = medium
			)
			average_content_rating
			(
				type = decimal
				displayname = "Average Content Rating"
				maxchar = 16
	 			row = 1
	 			column = 1   
				width = medium
			)
			average_delivery_rating
			(
				type = decimal
				displayname = "Average Delivery Rating"
				maxchar = 16
	 			row = 1
	 			column = 1   
				width = medium
			)
			average_clarity_rating
			(
				type = decimal
				displayname = "Average Clarity Rating"
				maxchar = 16
	 			row = 1
	 			column = 1   
				width = medium
			)
			average_engagement_rating
			(
				type = decimal
				displayname = "Average Engagement Rating"
				maxchar = 16
	 			row = 1
	 			column = 1   
				width = medium
			)
			trend_status
			(
				type = picklist
				displayname = "Trend Status"
				values = {"Stable","Improving","Deteriorating"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			last_updated
			(
    			type = date
				displayname = "Last Updated"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
			blueprint components
			{
				stages = {"Summary Created","Data Validation","Trend Analysis","Data Correction","Performance Review","Manual Review","Summary Finalized","Archive"}
			}
		}
		form student
		{
			displayname = "Student"
			success message = "Student Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have unique student_id
			(
    			type = text
				displayname = "Student Id"
	 			row = 1
	 			column = 1   
				width = medium
			)
			full_name
			(
    			type = name
				displayname = "Full Name"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
	     			 visibility = false
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
			email
			(
    			type = email
				displayname = "Email Address"
	 			row = 1
	 			column = 1   
				width = medium
			)
			phone_number
			(
    			type = phonenumber
				displayname = "Phone Number"
	 			row = 1
	 			column = 1   
				width = medium
			)
			department
			(
    			type = text
				displayname = "Department"
	 			row = 1
	 			column = 1   
				width = medium
			)
			current_semester
			(
    			type = text
				displayname = "Current Semester"
	 			row = 1
	 			column = 1   
				width = medium
			)
			student_status
			(
				type = picklist
				displayname = "Student Status"
				values = {"Active","Inactive","Graduated"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			academic_year
			(
    			type = text
				displayname = "Academic Year"
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
	}
	reports
	{
		list feedback_response_Report
		{
			displayName = "All Responses"
			show all rows from feedback_response    
			(
				response_id as "Response Id"
				student as "Student"
				course as "Course"
				submission_date as "Submission Date"
				content_quality_rating as "Content Quality Rating"
				delivery_rating as "Delivery Rating"
				clarity_rating as "Clarity Rating"
				engagement_rating as "Engagement Rating"
				overall_satisfaction as "Overall Satisfaction"
				suggestions as "Suggestions"
				is_anonymous as "Is Anonymous"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (overall_satisfaction == "Dissatisfied")
				fields = [overall_satisfaction]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (overall_satisfaction == "Neutral")
				fields = [overall_satisfaction]
				format = "color:#000000;background-color:#1bbc9b;"
				}
				"New Formatting3"
				{
				condition = (overall_satisfaction == "Satisfied")
				fields = [overall_satisfaction]
				format = "color:#ffffff;background-color:#e84c3d;"
				}
				"New Formatting4"
				{
				condition = (overall_satisfaction == "Very Satisfied")
				fields = [overall_satisfaction]
				format = "color:#ffffff;background-color:#3598db;"
				}
			)
		}
		kanban feedback_response_by_overall_satisfaction
		{
			displayName = "Responses Board"
			show all rows from feedback_response    
			(
				response_id as "Response Id"
				student as "Student"
				course as "Course"
				submission_date as "Submission Date"
				content_quality_rating as "Content Quality Rating"
				delivery_rating as "Delivery Rating"
				clarity_rating as "Clarity Rating"
				engagement_rating as "Engagement Rating"
				overall_satisfaction as "Overall Satisfaction"
				suggestions as "Suggestions"
				is_anonymous as "Is Anonymous"
			)
			options
			(
	 			display field = overall_satisfaction
	 		)
		}
		list semester_summary_Report
		{
			displayName = "All Semester Summaries"
			show all rows from semester_summary    
			(
				summary_id as "Summary Id"
				course as "Course"
				semester as "Semester"
				academic_year as "Academic Year"
				total_responses as "Total Responses"
				average_content_rating as "Average Content Rating"
				average_delivery_rating as "Average Delivery Rating"
				average_clarity_rating as "Average Clarity Rating"
				average_engagement_rating as "Average Engagement Rating"
				trend_status as "Trend Status"
				last_updated as "Last Updated"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (trend_status == "Improving")
				fields = [trend_status]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (trend_status == "Stable")
				fields = [trend_status]
				format = "color:#000000;background-color:#1bbc9b;"
				}
			)
		}
		kanban semester_summary_by_trend_status
		{
			displayName = "Trend Statuses"
			show all rows from semester_summary    
			(
				summary_id as "Summary Id"
				course as "Course"
				semester as "Semester"
				academic_year as "Academic Year"
				total_responses as "Total Responses"
				average_content_rating as "Average Content Rating"
				average_delivery_rating as "Average Delivery Rating"
				average_clarity_rating as "Average Clarity Rating"
				average_engagement_rating as "Average Engagement Rating"
				trend_status as "Trend Status"
				last_updated as "Last Updated"
			)
			options
			(
	 			display field = trend_status
	 		)
		}
		list student_Report
		{
			displayName = "All Students"
			show all rows from student    
			(
				student_id as "Student Id"
				full_name  as "Full Name"
				email as "Email Address"
				phone_number as "Phone Number"
				department as "Department"
				current_semester as "Current Semester"
				student_status as "Student Status"
				academic_year as "Academic Year"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (student_status == "Active")
				fields = [student_status]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (student_status == "Graduated")
				fields = [student_status]
				format = "color:#000000;background-color:#1bbc9b;"
				}
				"New Formatting3"
				{
				condition = (student_status == "Inactive")
				fields = [student_status]
				format = "color:#ffffff;background-color:#e84c3d;"
				}
			)
		}
		kanban student_by_student_status
		{
			displayName = "Student Statuses"
			show all rows from student    
			(
				student_id as "Student Id"
				full_name  as "Full Name"
				email as "Email Address"
				phone_number as "Phone Number"
				department as "Department"
				current_semester as "Current Semester"
				student_status as "Student Status"
				academic_year as "Academic Year"
			)
			options
			(
	 			display field = student_status
	 		)
		}
		list course_Report
		{
			displayName = "All Courses"
			show all rows from course    
			(
				course_code as "Course Code"
				course_name as "Course Name"
				instructor_name  as "Instructor Name"
				department as "Department"
				semester as "Semester"
				academic_year as "Academic Year"
				credits as "Credits"
				course_type as "Course Type"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (course_type == "Elective")
				fields = [course_type]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (course_type == "Lab")
				fields = [course_type]
				format = "color:#000000;background-color:#1bbc9b;"
				}
			)
		}
		kanban course_by_course_type
		{
			displayName = "Course Types"
			show all rows from course    
			(
				course_code as "Course Code"
				course_name as "Course Name"
				instructor_name  as "Instructor Name"
				department as "Department"
				semester as "Semester"
				academic_year as "Academic Year"
				credits as "Credits"
				course_type as "Course Type"
			)
			options
			(
	 			display field = course_type
	 		)
		}
		list ratings_by_course_type
		{
			displayName = "Ratings by Course Type"
			show all rows from feedback_response    
			(
				content_quality_rating as "Content Quality Rating"
				(
					display = total,average,min,max	
				)
				delivery_rating as "Delivery Rating"
				(
					display = total,average,min,max	
				)
				clarity_rating as "Clarity Rating"
				(
					display = total,average,min,max	
				)
				engagement_rating as "Engagement Rating"
				(
					display = total,average,min,max	
				)
				overall_satisfaction as "Overall Satisfaction"
				course as "Course"
				(
					delimiter = comma
				)
				student as "Student"
				(
					delimiter = comma
				)
				is_anonymous as "Is Anonymous"
				(
						displaytrue = "Yes"
						displayfalse = "No"
				)
				submission_date as "Submission Date"
				(
					displayformat = fulldate
				)
				response_id as "Response Id"
				suggestions as "Suggestions"
			)
			filters
			(
				overall_satisfaction
				is_anonymous
			)
			sort by
			(
				submission_date descending
			)
		}
		list ratings_by_course_type_pivot
		{
			displayName = "Ratings by Course Type - Pivot Chart"
			show all rows from feedback_response    
			(
				content_quality_rating as "Content Quality Rating"
				(
					display = average	
				)
				delivery_rating as "Delivery Rating"
				(
					display = average	
				)
				clarity_rating as "Clarity Rating"
				(
					display = average	
				)
				engagement_rating as "Engagement Rating"
				(
					display = average	
				)
				course as "Course"
				(
					delimiter = comma
				)
				response_id as "Response Id"
				submission_date as "Submission Date"
				student as "Student"
			)
			sort by
			(
				submission_date descending
			)
		}
	}
	pages
	{
		page DashBoard
