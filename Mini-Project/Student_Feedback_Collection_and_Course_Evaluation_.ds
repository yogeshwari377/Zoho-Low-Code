'left'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\tpadding = '5px'\n\n\t\thAlign = 'left'\n>\n\t<pr \n\t>\n\t<pc \n\t\n>\n\t<image  \n\t\tmarginLeft = '5px'\n\tmarginRight = '0px' \n\tmarginBottom = '0px'\n\tmarginTop = '0px'\n\n\tcolor = 'theme'\n\tbgColor = '#F1F2F4'\n\twidth = '40px'\n\theight = '40px'\n\ttype = 'icon'\n\tvalue = 'ui-2-square-add-08'\n\tsize = '16px'\n\tcornerRadius = '10px'\n\ticonType = 'outline'\n/>\n</pc><pc \n\t\n\t\thAlign = 'left'\n>\n\t<text \n    action = 'OpenForm'\n\t\tcomponentLinkName = 'feedback_response'\n\t\ttarget = 'new-window'\n\n\tmarginLeft = '12px'\n\tmarginRight = '0px' \n\tmarginBottom = '0px'\n\tmarginTop = '0px'\n\tpadding = '0px'\n\tcolor = 'theme'\n\tsize = '15px'\n\ttype = 'Text'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '2px'\n\n\n\n\n\n    borderColor = '#5051F9'\n    borderWidth = '0px'\n\n\t  value = 'Add New Feedback Response'\n>\n</text>\n\n</pc>\n</pr><pr \n\t>\n\t<pc \n\t\tpadding = '8px'\n\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n>\n\t\n</pc>\n</pr>\n</pc>\n</pr><pr \n\t>\n\t<pc \n\t\n>\n\t<image  \n\t\tmarginLeft = '5px'\n\tmarginRight = '0px' \n\tmarginBottom = '0px'\n\tmarginTop = '0px'\n\n\tcolor = 'theme'\n\tbgColor = '#F1F2F4'\n\twidth = '40px'\n\theight = '40px'\n\ttype = 'icon'\n\tvalue = 'ui-2-square-add-08'\n\tsize = '16px'\n\tcornerRadius = '10px'\n\ticonType = 'outline'\n/>\n</pc><pc \n\t\n\t\thAlign = 'left'\n>\n\t<text \n    action = 'OpenForm'\n\t\tcomponentLinkName = 'semester_summary'\n\t\ttarget = 'new-window'\n\n\tmarginLeft = '12px'\n\tmarginRight = '0px' \n\tmarginBottom = '0px'\n\tmarginTop = '0px'\n\tpadding = '0px'\n\tcolor = 'theme'\n\tsize = '15px'\n\ttype = 'Text'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '2px'\n\n\n\n\n\n    borderColor = '#5051F9'\n    borderWidth = '0px'\n\n\t  value = 'Add New Semester Summary'\n>\n</text>\n\n</pc>\n</pr><pr \n\t>\n\t<pc \n\t\tpadding = '8px'\n\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n>\n\t\n</pc>\n</pr>\n</pc>\n</pr><pr \n\t>\n\t<pc \n\t\n>\n\t<image  \n\t\tmarginLeft = '5px'\n\tmarginRight = '0px' \n\tmarginBottom = '0px'\n\tmarginTop = '0px'\n\n\tcolor = 'theme'\n\tbgColor = '#F1F2F4'\n\twidth = '40px'\n\theight = '40px'\n\ttype = 'icon'\n\tvalue = 'ui-2-square-add-08'\n\tsize = '16px'\n\tcornerRadius = '10px'\n\ticonType = 'outline'\n/>\n</pc><pc \n\t\n\t\thAlign = 'left'\n>\n\t<text \n    action = 'OpenForm'\n\t\tcomponentLinkName = 'student'\n\t\ttarget = 'new-window'\n\n\tmarginLeft = '12px'\n\tmarginRight = '0px' \n\tmarginBottom = '0px'\n\tmarginTop = '0px'\n\tpadding = '0px'\n\tcolor = 'theme'\n\tsize = '15px'\n\ttype = 'Text'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '2px'\n\n\n\n\n\n    borderColor = '#5051F9'\n    borderWidth = '0px'\n\n\t  value = 'Add New Student'\n>\n</text>\n\n</pc>\n</pr><pr \n\t>\n\t<pc \n\t\tpadding = '8px'\n\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n>\n\t\n</pc>\n</pr>\n</pc>\n</pr><pr \n\t>\n\t<pc \n\t\n>\n\t<image  \n\t\tmarginLeft = '5px'\n\tmarginRight = '0px' \n\tmarginBottom = '0px'\n\tmarginTop = '0px'\n\n\tcolor = 'theme'\n\tbgColor = '#F1F2F4'\n\twidth = '40px'\n\theight = '40px'\n\ttype = 'icon'\n\tvalue = 'ui-2-square-add-08'\n\tsize = '16px'\n\tcornerRadius = '10px'\n\ticonType = 'outline'\n/>\n</pc><pc \n\t\n\t\thAlign = 'left'\n>\n\t<text \n    action = 'OpenForm'\n\t\tcomponentLinkName = 'course'\n\t\ttarget = 'new-window'\n\n\tmarginLeft = '12px'\n\tmarginRight = '0px' \n\tmarginBottom = '0px'\n\tmarginTop = '0px'\n\tpadding = '0px'\n\tcolor = 'theme'\n\tsize = '15px'\n\ttype = 'Text'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '2px'\n\n\n\n\n\n    borderColor = '#5051F9'\n    borderWidth = '0px'\n\n\t  value = 'Add New Course'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<chart \n\telementName='Chart 2'\n\n\t\n\ttitle = 'Trend Status by Total Responses'\n\t\n\ttype = 'Bar'\n\txtitle = 'Trend Status'\n\tytitle = 'Total Responses'\n\tbgColor = '#FFFFFF'\n\ttheme = 'theme'\n\tlegendPos = 'none'\n\theightType = 'auto'\n\theightValue = '300px'\n\tappLinkName = 'thisapp'\n\tformLinkName = 'semester_summary'\n\txfield = 'trend_status'\n\tyfields = 'sum:total_responses'\n\tgroupBy = 'summary_id'\n\t\tDelugeCriteria = 'trend_status is not null &amp;&amp; trend_status != &quot;&quot;'\n/>\n\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<report \n\telementName='Report'\n\n\t\tappLinkName = 'thisapp'\n\t\tlinkName = 'feedback_response_Report'\n\t\n\t\tiszreport = 'false'\n\theightType = 'auto'\n\theightValue = '700'\n/>\n</column>\n</row>\n</layout>\n</zml>"
		}
	}


		 functions
		 {
			 Deluge
			 {
				 float Calculate_Average_Feedback_Rating(course courseRecord)
                 {
                 	// Fetch all feedback records for the given course
                 	feedbackRecords = feedback_response[course == courseRecord.ID];
                 	// Initialize sum variables
                 	contentSum = 0.0;
                 	deliverySum = 0.0;
                 	claritySum = 0.0;
                 	engagementSum = 0.0;
                 	count = 0;
                 	// Iterate through records to calculate sums
                 	for each  record in feedbackRecords
                 	{
                 		if(!record.content_quality_rating.isNull())
                 		{
                 			contentSum = contentSum + record.content_quality_rating;
                 		}
                 		if(!record.delivery_rating.isNull())
                 		{
                 			deliverySum = deliverySum + record.delivery_rating;
                 		}
                 		if(!record.clarity_rating.isNull())
                 		{
                 			claritySum = claritySum + record.clarity_rating;
                 		}
                 		if(!record.engagement_rating.isNull())
                 		{
                 			engagementSum = engagementSum + record.engagement_rating;
                 		}
                 		count = count + 1;
                 	}
                 	// Calculate average if records exist
                 	if(count > 0)
                 	{
                 		totalSum = contentSum + deliverySum + claritySum + engagementSum;
                 		totalRatings = count * 4;
                 		averageRating = totalSum / totalRatings;
                 	}
                 	else
                 	{
                 		averageRating = 0.0;
                 	}
                 	return averageRating;
                 }
				 map Generate_Course_Feedback_Summary(course courseRecord)
                 {
                 	// Initialize result map
                 	result = Map();
                 	// Fetch all feedback responses for the given course
                 	feedbackList = feedback_response[course == courseRecord.ID];
                 	// Get count of feedback responses
                 	feedbackCount = feedbackList.count();
                 	// Initialize sum variables for each rating field
                 	sumContent = 0;
                 	sumDelivery = 0;
                 	sumClarity = 0;
                 	sumEngagement = 0;
                 	// Iterate through each feedback record to calculate sums
                 	if(feedbackCount > 0)
                 	{
                 		for each  feedback in feedbackList
                 		{
                 			// Get rating values, default to 0 if null
                 			contentRating = ifNull(feedback.content_quality_rating,0);
                 			deliveryRating = ifNull(feedback.delivery_rating,0);
                 			clarityRating = ifNull(feedback.clarity_rating,0);
                 			engagementRating = ifNull(feedback.engagement_rating,0);
                 			// Accumulate sums
                 			sumContent = sumContent + contentRating;
                 			sumDelivery = sumDelivery + deliveryRating;
                 			sumClarity = sumClarity + clarityRating;
                 			sumEngagement = sumEngagement + engagementRating;
                 		}
                 		// Calculate total sum of all ratings
                 		totalSum = sumContent + sumDelivery + sumClarity + sumEngagement;
                 		// Calculate overall average (total sum divided by 4 rating fields * number of responses)
                 		totalRatingsCount = feedbackCount * 4;
                 		overallAverage = totalSum / totalRatingsCount;
                 	}
                 	else
                 	{
                 		overallAverage = 0;
                 	}
                 	// Populate result map
                 	result.put("feedback_count",feedbackCount);
                 	result.put("overall_average_rating",overallAverage);
                 	// Return the summary map
                 	return result;
                 }
				 int Get_Course_Feedback_Count(course courseRecord)
                 {
                 	// Fetch all feedback responses for the given course record
                 	feedbackRecords = feedback_response[course == courseRecord.ID];
                 	// Get the count of matching records
                 	count = feedbackRecords.count();
                 	// Return the count
                 	return count;
                 }
			 }
		 }


		workflow
		{
		form
		{
			auto_fill_student_email as "Auto-fill Student Email"
			{
				type =  form
				form = student

				record event = on add

				on load
				{
					actions 
					{
						custom deluge script
						(
											input.email = zoho.loginuserid;
										disable email;
						)
					}
				}

			}
			validate_feedback_ratings as "Validate Feedback Ratings"
			{
				type =  form
				form = feedback_response

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(input.engagement_rating != null && input.engagement_rating < 1 || input.engagement_rating > 5)
										{
											alert "Engagement rating must be between 1 and 5";
											cancel submit;
										}
										if(input.clarity_rating != null && input.clarity_rating < 1 || input.clarity_rating > 5)
										{
											alert "Clarity rating must be between 1 and 5";
											cancel submit;
										}
										if(input.delivery_rating != null && input.delivery_rating < 1 || input.delivery_rating > 5)
										{
											alert "Delivery rating must be between 1 and 5";
											cancel submit;
										}
										if(input.content_quality_rating != null && input.content_quality_rating < 1 || input.content_quality_rating > 5)
										{
											alert "Content quality rating must be between 1 and 5";
											cancel submit;
										}
						)
					}
				}

			}
			feedback_submission_confirmation as "Feedback Submission Confirmation"
			{
				type =  form
				form = feedback_response

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											// Fetch student records based on the selected students in the feedback response
										studentList = student[ID in input.student.ID.getall()];
										// Prepare email subject and message
										emailSubject = "Feedback Submission Confirmation";
										emailMessage = "<p>Dear Student,</p><p>Your feedback for the course has been successfully submitted.</p><p>Thank you for your valuable input.</p><p>Best Regards,<br/>Course Evaluation Team</p>";
										// Send email to each student
										for each  studentRec in studentList
										{
											if(studentRec.email != null)
											{
												sendmail
												[
													from :zoho.adminuserid
													to :studentRec.email
													subject :emailSubject
													message :emailMessage
												]
											}
										}
						)
					}
				}

			}
			academic_staff_notification as "Academic Staff Notification"
			{
				type =  form
				form = feedback_response

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											// Fetch the student record using the multi-select lookup ID
										studentID = input.student.ID;
										studentRecord = student[ID == studentID];
										// Fetch the course record using the multi-select lookup ID
										courseID = input.course.ID;
										courseRecord = course[ID == courseID];
										// Check if instructor email exists
										if(courseRecord.instructor_email != null)
										{
											if(input.is_anonymous == false)
											{
												// Send email with student details
												sendmail
												[
													from :zoho.adminuserid
													to :courseRecord.instructor_email
													subject :"Student Feedback for " + courseRecord.course_name
													message :"<p>Dear " + courseRecord.instructor_name.first_name + ",</p>" + "<p>You have received feedback from a student.</p>" + "<p><strong>Student Name:</strong> " + studentRecord.full_name.first_name + " " + studentRecord.full_name.last_name + "</p>" + "<p><strong>Course:</strong> " + courseRecord.course_name + "</p>" + "<p><strong>Content Quality Rating:</strong> " + input.content_quality_rating + "</p>" + "<p><strong>Delivery Rating:</strong> " + input.delivery_rating + "</p>" + "<p><strong>Clarity Rating:</strong> " + input.clarity_rating + "</p>" + "<p><strong>Engagement Rating:</strong> " + input.engagement_rating + "</p>" + "<p><strong>Overall Satisfaction:</strong> " + input.overall_satisfaction + "</p>" + "<p><strong>Suggestions:</strong> " + input.suggestions + "</p>"
												]
											}
											else
											{
												// Send email without student details (anonymous feedback)
												sendmail
												[
													from :zoho.adminuserid
													to :courseRecord.instructor_email
													subject :"Anonymous Student Feedback for " + courseRecord.course_name
													message :"<p>Dear " + courseRecord.instructor_name.first_name + ",</p>" + "<p>You have received anonymous feedback from a student.</p>" + "<p><strong>Course:</strong> " + courseRecord.course_name + "</p>" + "<p><strong>Content Quality Rating:</strong> " + input.content_quality_rating + "</p>" + "<p><strong>Delivery Rating:</strong> " + input.delivery_rating + "</p>" + "<p><strong>Clarity Rating:</strong> " + input.clarity_rating + "</p>" + "<p><strong>Engagement Rating:</strong> " + input.engagement_rating + "</p>" + "<p><strong>Overall Satisfaction:</strong> " + input.overall_satisfaction + "</p>" + "<p><strong>Suggestions:</strong> " + input.suggestions + "</p>"
												]
											}
										}
										else
										{
											// Log if instructor email is missing
											info "Instructor email not found for course: " + courseRecord.course_name;
										}
						)
					}
				}

			}
		}

		schedule
		{
			monthly_semester_summary as "Monthly Semester Summary Report"
			{
				type =  schedule
				start = "2026-11-01 09:00:00"
				frequency = monthly
				time zone = "Asia/Kolkata"
				on start
				{
					actions 
					{
					on load
					(
						// Fetch all semester summary records
										semesterSummaries = semester_summary[ID != 0];
										// Check if there are any summaries to process
										if(semesterSummaries.count() > 0)
										{
											// Build the report content
											reportContent = "<h2>Monthly Semester Summary Report</h2>";
											reportContent = reportContent.concat("<p>Generated on: ").concat(zoho.currentdate.toText("MMM dd, yyyy"));
											reportContent = reportContent.concat("</p><table border='1' cellpadding='5' cellspacing='0'>");
											reportContent = reportContent.concat("<tr><th>Semester</th><th>Academic Year</th><th>Total Responses</th><th>Avg Engagement</th><th>Avg Clarity</th><th>Avg Delivery</th><th>Avg Content</th><th>Trend</th></tr>");
											// Iterate through each semester summary
											for each  summary in semesterSummaries
											{
												// Get semester and academic year
												semesterName = summary.semester;
												academicYear = summary.academic_year;
												// Get ratings (handle null values)
												avgEngagement = summary.average_engagement_rating;
												avgClarity = summary.average_clarity_rating;
												avgDelivery = summary.average_delivery_rating;
												avgContent = summary.average_content_rating;
												// Format ratings for display
												if(avgEngagement.isNull())
												{
													engagementDisplay = "N/A";
												}
												else
												{
													engagementDisplay = avgEngagement.toString();
												}
												if(avgClarity.isNull())
												{
													clarityDisplay = "N/A";
												}
												else
												{
													clarityDisplay = avgClarity.toString();
												}
												if(avgDelivery.isNull())
												{
													deliveryDisplay = "N/A";
												}
												else
												{
													deliveryDisplay = avgDelivery.toString();
												}
												if(avgContent.isNull())
												{
													contentDisplay = "N/A";
												}
												else
												{
													contentDisplay = avgContent.toString();
												}
												// Get trend status
												trendStatus = summary.trend_status;
												if(trendStatus.isNull())
												{
													trendDisplay = "N/A";
												}
												else
												{
													trendDisplay = trendStatus;
												}
												// Get total responses
												totalResponses = summary.total_responses;
												if(totalResponses.isNull())
												{
													responsesDisplay = "0";
												}
												else
												{
													responsesDisplay = totalResponses.toString();
												}
												// Add row to table
												reportContent = reportContent.concat("<tr>");
												reportContent = reportContent.concat("<td>").concat(semesterName).concat("</td>");
												reportContent = reportContent.concat("<td>").concat(academicYear).concat("</td>");
												reportContent = reportContent.concat("<td>").concat(responsesDisplay).concat("</td>");
												reportContent = reportContent.concat("<td>").concat(engagementDisplay).concat("</td>");
												reportContent = reportContent.concat("<td>").concat(clarityDisplay).concat("</td>");
												reportContent = reportContent.concat("<td>").concat(deliveryDisplay).concat("</td>");
												reportContent = reportContent.concat("<td>").concat(contentDisplay).concat("</td>");
												reportContent = reportContent.concat("<td>").concat(trendDisplay).concat("</td>");
												reportContent = reportContent.concat("</tr>");
											}
											reportContent = reportContent.concat("</table>");
											// Send email to admin
											sendmail
											[
												from :zoho.adminuserid
												to :zoho.adminuserid
												subject :"Monthly Semester Summary Report - " + zoho.currentdate.toText("MMMM yyyy")
												message :reportContent
												content type :HTML
											]
										}
					)
					}
				}
			}
		}


